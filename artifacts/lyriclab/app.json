{
  "expo": {
    "name": "LyricLab",
    "slug": "lyriclab",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "lyriclab",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": { "image": "./assets/images/icon.png", "resizeMode": "contain", "backgroundColor": "#0A0A0F" },
    "ios": { "supportsTablet": false, "bundleIdentifier": "com.lyriclab.app", "buildNumber": "1" },
    "android": { "package": "com.lyriclab.app", "versionCode": 1, "adaptiveIcon": { "foregroundImage": "./assets/images/icon.png", "backgroundColor": "#0A0A0F" } },
    "web": { "favicon": "./assets/images/icon.png" },
    "plugins": [ [ "expo-router", { "origin": "https://replit.com/" } ], "expo-font", "expo-web-browser" ],
    "experiments": { "typedRoutes": true, "reactCompiler": true }
  }
}
